---
import Layout from '@/layouts/Layout.astro';
import { Card, CardHeader, CardTitle, CardDescription } from "@web-noise-cleaner/ui/components/ui/card";
import { buttonVariants } from "@web-noise-cleaner/ui/components/ui/button";
import { FaqSection } from "@/components/FaqSection";
import { cn } from "@web-noise-cleaner/ui/lib/utils";
import { features, supportedSites, installSteps, RELEASE_URL, metadata } from '@/constants';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const img = (path: string) => base + path.replace(/^\//, '');
---

<Layout title={metadata.title} description={metadata.description}>
  <main class="min-h-screen">
    <!-- Hero -->
    <section class="relative overflow-hidden px-6 py-16 sm:py-24 lg:px-8">
      <div class="mx-auto flex max-w-6xl flex-col items-center gap-10 lg:flex-row lg:gap-16">
        <!-- Left: Extension screenshot (desktop) -->
        <div class="relative w-full max-w-sm shrink-0 max-lg:hidden">
          <div class="absolute -inset-x-4 -inset-y-2 rounded-[2rem] bg-linear-to-b from-primary/10 to-transparent blur-3xl" aria-hidden="true" />
          <div class="relative rounded-2xl shadow-2xl ring-1 ring-border/40 bg-background/80 backdrop-blur-xs">
            <div class="flex items-center gap-1.5 border-b border-border/30 px-4 py-3">
              <div class="size-2.5 rounded-full bg-red-400" />
              <div class="size-2.5 rounded-full bg-yellow-400" />
              <div class="size-2.5 rounded-full bg-green-400" />
              <span class="ml-2 text-[10px] text-muted-foreground/60 font-mono">Web Noise Cleaner</span>
            </div>
            <img
              src={img("hero-1.png")}
              alt="Web Noise Cleaner のポップアップ画面"
              class="w-full h-auto rounded-b-2xl"
            />
          </div>
        </div>

        <!-- Left: Extension screenshot (mobile) -->
        <div class="w-full max-w-70 lg:hidden">
          <div class="rounded-2xl shadow-xl ring-1 ring-border/30">
            <img
              src={img("hero-1.png")}
              alt="Web Noise Cleaner のポップアップ画面"
              class="w-full h-auto rounded-2xl"
            />
          </div>
        </div>

        <!-- Right: Hero text + CTA -->
        <div class="flex flex-col items-center text-center lg:items-start lg:text-left">
          <div class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-medium text-primary">
            <span class="size-1.5 rounded-full bg-primary animate-pulse" />
            Chrome 拡張機能
          </div>

          <h1 class="mt-6 text-4xl font-bold tracking-tight sm:text-5xl xl:text-6xl">
            <span class="bg-linear-to-r from-foreground to-foreground/65 bg-clip-text text-transparent">
              {metadata.title}
            </span>
          </h1>
          <p class="mt-4 max-w-lg text-base leading-relaxed text-muted-foreground sm:text-lg">
            {metadata.description}
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <a
              href={RELEASE_URL}
              class={cn(buttonVariants({ variant: "default", size: "lg" }), "px-8 py-3 text-base font-semibold shadow-md")}
            >
              <svg class="mr-2 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
              ダウンロード
            </a>
          </div>
        </div>
      </div>
      </div>

      <!-- Subtle gradient overlay on the left edge -->
      <div class="pointer-events-none absolute inset-y-0 left-0 w-64 bg-linear-to-r from-background to-transparent max-lg:hidden" />
    </section>

    <!-- Features -->
    <section class="px-6 pb-16 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h2 class="text-2xl font-bold text-center mb-12">主な機能</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {features.map((feature) => (
            <Card>
              <CardHeader>
                <CardTitle>{feature.title}</CardTitle>
                <CardDescription>
                  {feature.description}
                </CardDescription>
              </CardHeader>
            </Card>
          ))}
        </div>
      </div>
    </section>

    <!-- Supported Sites -->
    <section class="px-6 py-16 lg:px-8 bg-muted/30">
      <div class="mx-auto max-w-5xl text-center">
        <h2 class="text-2xl font-bold mb-8">対応サイト</h2>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
          {supportedSites.map((site) => (
            <Card>
              <div class="text-3xl mb-2">{site.icon}</div>
              <div class="font-medium text-sm">{site.name}</div>
            </Card>
          ))}
        </div>
      </div>
    </section>

    <div class="mt-10 flex items-center justify-center gap-x-6">
      <a
        href={RELEASE_URL}
        class={cn(buttonVariants({ variant: "default",size:"lg" }), "px-6 py-3 text-lg font-semibold")}
      >
        <svg class="mr-2 size-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
        ダウンロード
      </a>
    </div>

    <!-- Installation -->
    <section class="px-6 py-16 lg:px-8">
      <div class="mx-auto max-w-5xl">
        <h2 class="text-2xl font-bold text-center mb-12">インストール方法</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          {installSteps.map((item) => (
            <Card>
              <div class="px-3">
                <span class="text-xs font-bold text-primary tracking-wider uppercase">
                  Step {item.step}
                </span>
                <h3 class="font-semibold text-base mt-2 mb-2">{item.title}</h3>
                <p class="text-xs text-muted-foreground leading-relaxed">
                  {item.description}
                </p>
              </div>
            </Card>
          ))}
        </div>
      </div>
    </section>

    <!-- Installation screenshot -->
    <section class="px-6 pb-16 lg:px-8">
      <div class="mx-auto max-w-xl">
        <div class="relative overflow-hidden rounded-xl shadow-lg ring-1 ring-border/40 bg-muted/10">
          <img
            src={img("hero-2.png")}
            alt="ブラウザの拡張機能管理画面"
            class="w-full h-auto object-contain"
            loading="lazy"
          />
        </div>
        <p class="mt-3 text-xs text-center text-muted-foreground">
          Chrome の拡張機能管理画面 — デベロッパーモードをONにして拡張機能を読み込みます
        </p>
      </div>
    </section>
    <!-- FAQ Section -->
    <FaqSection client:only="react" />
    <!-- Footer -->
    <footer class="px-6 py-8 text-center text-sm text-muted-foreground border-t">
      <p>&copy; {new Date().getFullYear()} Web Noise Cleaner</p>
    </footer>
  </main>
</Layout>
