---
import Layout from "@/layouts/Layout.astro";
import { metadata } from "@/constants";
import HeroSection from "@/components/hero-section.astro";
import FeaturesSection from "@/components/features-section.astro";
import SupportedSitesSection from "@/components/supported-sites-section.astro";
import InstallationSection from "@/components/installation-section.astro";
---

<Layout title={metadata.title} description={metadata.description}>
  <main class="min-h-screen">
    <HeroSection />
  </main>
  <FeaturesSection />
  <SupportedSitesSection />
  <InstallationSection />
</Layout>
