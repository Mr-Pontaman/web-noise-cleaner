---
import { DlButton } from "@/components/dl-button";
import { metadata } from "@/constants";
import { CiYoutube } from "react-icons/ci";
---

<section class="relative overflow-hidden px-6 py-16 sm:py-24 lg:px-8">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-10 lg:flex-row lg:gap-16">
    <div class="relative w-full max-w-sm shrink-0 max-lg:hidden">
      <div class="absolute -inset-x-4 -inset-y-2 rounded-[2rem] bg-linear-to-b from-primary/10 to-transparent blur-3xl" aria-hidden="true"></div>
      <div class="relative rounded-2xl shadow-2xl ring-1 ring-border/40 bg-background/80 backdrop-blur-xs">
        <div class="flex items-center gap-1.5 border-b border-border/30 px-4 py-3">
          <div class="size-2.5 rounded-full bg-red-400"></div>
          <div class="size-2.5 rounded-full bg-yellow-400"></div>
          <div class="size-2.5 rounded-full bg-green-400"></div>
          <span class="ml-2 text-[10px] text-muted-foreground/60 font-mono">Web Noise Cleaner</span>
        </div>
        <img src={`${import.meta.env.BASE_URL}/hero-1.png`} alt="Web Noise Cleaner のポップアップ画面" class="w-full h-auto rounded-b-2xl" />
      </div>
    </div>

    <div class="w-full max-w-70 lg:hidden">
      <div class="rounded-2xl shadow-xl ring-1 ring-border/30">
        <img src={`${import.meta.env.BASE_URL}/hero-1.png`} alt="Web Noise Cleaner のポップアップ画面" class="w-full h-auto rounded-2xl" />
      </div>
    </div>

    <div class="flex flex-col relative items-center text-center lg:items-start lg:text-left">
      <div class="inline-flex items-center gap-1.5 rounded-full border border-primary/20 bg-primary/5 px-3 py-1 text-xs font-medium text-primary">
        <span class="size-1.5 rounded-full bg-primary animate-pulse"></span>
        Chrome 拡張機能
      </div>
      <h1 class="mt-6 text-4xl font-bold tracking-tight sm:text-5xl xl:text-6xl">
        <span class="bg-linear-to-r from-foreground to-foreground/65 bg-clip-text text-transparent">{metadata.title}</span>
      </h1>
      <p class="mt-4 max-w-lg text-base leading-relaxed text-muted-foreground sm:text-lg">{metadata.description}</p>
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <DlButton />
      </div>
    </div>

    <div class="max-lg:hidden lg:absolute -bottom-10 right-4 xl:right-12 rotate-12 z-10 rounded-2xl shadow-xl ring-1 ring-border/40">
      <div class="relative">
        <CiYoutube color="white" className="size-4 absolute top-1 left-1 z-20" />
        <img src={`${import.meta.env.BASE_URL}/hero-3.png`} alt="Web Noise Cleaner のポップアップ画面" class="w-80 lg:w-100 xl:w-120 h-auto rounded-2xl shadow-2xl" />
      </div>
    </div>
  </div>
</section>

<div class="pointer-events-none absolute inset-y-0 left-0 w-64 bg-linear-to-r from-background to-transparent max-lg:hidden"></div>
